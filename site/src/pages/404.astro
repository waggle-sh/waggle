import '../assets/brand/tokens.css';
import '../styles/site.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Waggle</title>
    <meta name="description" content="This path is not on the Waggle site." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="lp">
    <div class="lp-wrap">
      <nav class="lp-nav" aria-label="Main">
        <a class="mark" href="/">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          Waggle
        </a>
        <a href="/docs/">Docs</a>
      </nav>
      <header class="lp-hero">
        <div class="lp-hero-row">
          <img
            class="lp-walt"
            src="/brand/mascot/walt-vector-normalized.svg"
            alt="Walt, the Waggle bee"
            width="88"
            height="70"
          />
          <div>
            <h1>This path is empty.</h1>
            <p class="lede">Walt checked. Nothing here is on the site.</p>
            <div class="lp-actions">
              <a class="lp-btn primary" href="/">Back home</a>
              <a class="lp-btn" href="/docs/">Read the docs</a>
            </div>
          </div>
        </div>
      </header>
    </div>
  </body>
</html>
