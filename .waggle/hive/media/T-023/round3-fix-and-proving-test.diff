new file mode 100644
index 0000000..5d371ff
--- /dev/null
+++ b/internal/dispatch/round3_test.go
@@ -0,0 +1,30 @@
+//go:build unix
+
+package dispatch
+
+// T-023 item 23 (D-178): a worker commit must not start a detached git
+// maintenance daemon that changes host state around the post-run check.
+
+import (
+	"os"
+	"testing"
+)
+
+// TestRunPlantDuringAutoMaintenance is the proving test for item 23: the plant
+// still follows the result line, and a second worker commit starts git's
+// detached auto maintenance while the entry has no gitdir file yet. Without
+// maintenance.auto=false in the worker's git config, that daemon (which left
+// the worker's process group) prunes the entry before the post-run check.
+func TestRunPlantDuringAutoMaintenance(t *testing.T) {
+	eachRepoSpelling(t, func(t *testing.T, link bool) {
+		f := newFixture(t, true, link)
+		planted := f.common() + "/worktrees/planted"
+		scen := okScenario + "mkdir '" + planted + "'\n" + commitFile("internal/x/c.go", "two") +
+			"sleep 1\nprintf '%s\\n' \"$PWD/.git\" > '" + planted + "/gitdir'\n"
+		res, err := f.run(scen)
+		if err != nil || res.ExitCode != 1 || !hasViolation(res.Violations, ruleHost, "worktrees/planted") {
+			_, serr := os.Stat(planted)
+			t.Fatalf("exit %d err %v violations %v (planted stat after run: %v)", res.ExitCode, err, res.Violations, serr)
+		}
+	})
+}
