{
  "version": 1,
  "profile": "{{PROFILE}}",
  "entry": "queen",
  "roles": [
    {
      "id": "queen",
      "min_level": "frontier",
      "runs": "session",
      "workspace": "main",
      "purpose": "Single conversational interface for the Keeper; surfaces AskUserQuestion decision cards.",
      "owns": [],
      "never": ["wait on workers", "write feature code or specs", "edit .waggle/hive/DECISIONS.md", "lower a gate"]
    },
    {
      "id": "scout",
      "min_level": "frontier",
      "runs": "worker",
      "workspace": "main",
      "purpose": "Breaks down goals into <400-line task briefs with directory leases and Light/Full gate tags.",
      "owns": [".waggle/hive/ROADMAP.md", ".waggle/hive/specs/**", ".waggle/hive/tasks/**"],
      "never": ["write feature implementation code", "talk directly to the Keeper"]
    },
    {
      "id": "forager",
      "min_level": "fast",
      "runs": "worker",
      "workspace": "cell-ro",
      "allow_unattended": true,
      "purpose": "Reproduces bugs, writes failing tests, maps required directory leases.",
      "owns": [],
      "never": ["write feature implementation code", "modify files outside test repro"]
    },
    {
      "id": "builder",
      "min_level": "standard",
      "runs": "worker",
      "workspace": "cell-rw-lease",
      "allow_unattended": false,
      "purpose": "Implements one task from its brief (.waggle/hive/tasks/T-<id>.md) inside leased directories.",
      "owns": ["<leased-directories>"],
      "never": ["touch files outside lease", "read full .waggle/hive/WORKPLAN.md or backlog", "hold host credentials"]
    },
    {
      "id": "guard",
      "min_level": "standard",
      "runs": "worker",
      "workspace": "cell-ro",
      "require_cross_model": true,
      "purpose": "Verifies acceptance criteria, and returns Risk Tier + Intent Packet + Verdict as its final message.",
      "owns": [],
      "never": ["fix bugs itself", "invent hypothetical nitpicks"]
    }
  ]
}
