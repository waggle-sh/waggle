# Waggle gate configuration: the merge gate in CI reads this file, and a full install adds more keys later.
# Edit protected_paths and approvers below; every other change is made through waggle upgrade.
version: 1

waggle:
  pin: {{PIN}} # the Waggle build this repo runs: a release tag or a 40-hex commit. Change only through a logged upgrade.

forge:
  provider: github
  remote: origin # claims are pushed to this remote and the gate fetches them from it

gate:
  # Comma separated repo-relative paths that change only with a listed approver's approval or an admin bypass.
  protected_paths: ""
  # Comma separated GitHub logins, without @, who may approve changes to protected paths.
  approvers: ""
